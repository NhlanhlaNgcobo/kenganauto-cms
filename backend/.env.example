# ─────────────────────────────────────────────────────────────
# KenganAuto OS — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Security (REQUIRED in production) ────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_32

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_for_AES_256_key

# ── Database ──────────────────────────────────────────────────
# Development uses SQLite (no config needed — file: ./dev_database.sqlite)
# Production uses PostgreSQL:
DATABASE_URL=postgresql://user:password@host:5432/kenganauto_prod

# ── AI Engine ────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXX

# ── Stripe Billing ────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXX

# Stripe Price IDs (create in Stripe dashboard under Products)
STRIPE_PRICE_STARTER=price_XXXXXXX     # R5,500/month
STRIPE_PRICE_GROWTH=price_XXXXXXX      # R12,500/month
STRIPE_PRICE_ENTERPRISE=price_XXXXXXX  # R22,000/month

# ── WhatsApp / 360dialog ─────────────────────────────────────
# Get from: https://hub.360dialog.com/
# Note: per-tenant keys are saved via the WhatsApp Settings page in the OS.
# This is only used if you want a global fallback.
WEBHOOK_VERIFY_TOKEN=kenganauto-verify
API_PUBLIC_URL=https://api.kenganauto.co.za

# ── Email (Resend) ────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXX

# ── SMS (Clickatell + Twilio fallback) ───────────────────────
CLICKATELL_API_KEY=XXXXXXX
TWILIO_ACCOUNT_SID=ACXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXX
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Dev Helpers ───────────────────────────────────────────────
# Override the chatbot demo tenant name (used when DB tenant not found)
DEMO_TENANT_NAME=KenganAuto Demo Motors
