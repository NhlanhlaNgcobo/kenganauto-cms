generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  starter
  growth
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum UserRole {
  admin
  salesperson
  finance_manager
  service_advisor
  parts_manager
}

enum LeadStatus {
  new
  contacted
  qualified
  test_drive_booked
  negotiation
  won
  lost
}

enum ConversationChannel {
  website
  whatsapp
  facebook
  email
}

enum VehicleCondition {
  new
  demo
  used
}

enum VehicleStatus {
  available
  reserved
  sold
}

enum TradeInStatus {
  enquiry
  valued
  inspection_booked
  offer_made
  accepted
  declined
}

enum FinanceStatus {
  pending
  submitted
  approved
  declined
}

enum ServiceStatus {
  booked
  checked_in
  in_progress
  awaiting_parts
  quality_check
  ready_for_collection
  completed
  cancelled
}

enum PartsStatus {
  enquiry
  quoted
  ordered
  ready
  collected
}

enum IntegrationStatus {
  unconfigured
  configured
  connected
  error
}

enum IntegrationType {
  stripe
  whatsapp_360dialog
  resend
  twilio
  clickatell
  sendgrid_parse
  generic_webhook
  facebook
  transunion
  maps
}

model Tenant {
  id                  Int                  @id @default(autoincrement())
  name                String
  subdomain           String               @unique
  plan                Plan                 @default(starter)
  whatsappNumber      String?
  logoUrl             String?
  primaryColor        String               @default("#C9A84C")
  address             String?
  city                String?
  province            String?
  active              Boolean              @default(true)
  stripeCustomerId    String?
  subscriptionStatus  SubscriptionStatus   @default(trialing)
  trialEndsAt         DateTime?
  currentPeriodEnd    DateTime?
  setupFeePaid        Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  leads               Lead[]
  conversations       Conversation[]
  vehicles            Vehicle[]
  tradeIns            TradeIn[]
  financeApplications FinanceApplication[]
  serviceBookings     ServiceBooking[]
  partsEnquiries      PartsEnquiry[]
  partsCatalog        PartCatalogItem[]
  customers           Customer[]
  automationSequences AutomationSequence[]
  automationRuns      AutomationExecution[]
  notificationSetting TenantNotificationSetting?
  notificationLogs    NotificationDelivery[]
  widgetSetting       WidgetSetting?
  integrations        IntegrationConnection[]
  whatsappSetting     WhatsappSetting?
  apiSettings         ApiSetting[]
  analyticsEvents     AnalyticsEvent[]
  supportManuals      SupportManual[]
  supportFaqs         SupportFaq[]
  supportQueries      SupportQuery[]
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  webhooks            WebhookIdempotency[]
}

model User {
  id           Int              @id @default(autoincrement())
  tenantId     Int
  firstName    String
  lastName     String
  email        String
  passwordHash String
  role         UserRole
  phone        String?
  active       Boolean          @default(true)
  lastLogin    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]          @relation("AssignedLeadUser")
  refreshSessions RefreshSession[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
}

model RefreshSession {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  userId     Int
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  tenantId   Int
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id             Int             @id @default(autoincrement())
  tenantId       Int
  customerName   String
  customerPhone  String?
  customerEmail  String?
  source         String
  vehicleInterest String?
  budgetMin      Decimal?        @db.Decimal(12, 2)
  budgetMax      Decimal?        @db.Decimal(12, 2)
  status         LeadStatus      @default(new)
  assignedToId   Int?
  aiScore        Int             @default(0)
  aiSummary      String?
  notes          Json?
  lastContactAt  DateTime?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo     User?           @relation("AssignedLeadUser", fields: [assignedToId], references: [id])
  conversations  Conversation[]
  leadNotes      LeadNote[]
  tradeIns       TradeIn[]
  financeApplications FinanceApplication[]
  @@index([tenantId, status])
}

model LeadNote {
  id         Int      @id @default(autoincrement())
  tenantId    Int
  leadId      Int
  authorId    Int?
  note        String
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
}

model Conversation {
  id             Int                 @id @default(autoincrement())
  tenantId       Int
  leadId         Int?
  channel        ConversationChannel
  externalUserId String?
  intentDetected String?
  sentimentScore Decimal?            @db.Decimal(5, 2)
  aiSummary      String?
  sessionData    Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead           Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages       ConversationMessage[]

  @@index([tenantId, updatedAt])
}

model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Vehicle {
  id          Int              @id @default(autoincrement())
  tenantId    Int
  make        String
  model       String
  year        Int
  variant     String?
  colour      String?
  mileage     Int?
  price       Decimal          @db.Decimal(12, 2)
  costPrice   Decimal?         @db.Decimal(12, 2)
  condition   VehicleCondition
  stockNumber String
  vin         String
  status      VehicleStatus    @default(available)
  images      Json?
  features    Json?
  description String?
  daysInStock Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stockNumber])
  @@unique([tenantId, vin])
  @@index([tenantId, status])
}

model TradeIn {
  id             Int           @id @default(autoincrement())
  tenantId       Int
  leadId         Int?
  year           Int
  make           String
  model          String
  mileage        Int?
  condition      String?
  colour         String?
  accidentDamage String?
  registration   String?
  vin            String?
  estimatedValue Decimal?      @db.Decimal(12, 2)
  dealerOffer    Decimal?      @db.Decimal(12, 2)
  status         TradeInStatus @default(enquiry)
  photos         Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

model FinanceApplication {
  id                 Int           @id @default(autoincrement())
  tenantId           Int
  leadId             Int?
  monthlyIncome      Decimal?      @db.Decimal(12, 2)
  employmentStatus   String?
  employerName       String?
  yearsEmployed      Int?
  existingDebt       Decimal?      @db.Decimal(12, 2)
  depositAmount      Decimal?      @db.Decimal(12, 2)
  vehiclePrice       Decimal?      @db.Decimal(12, 2)
  termMonths         Int?
  interestRate       Decimal?      @db.Decimal(5, 2)
  monthlyInstallment Decimal?      @db.Decimal(12, 2)
  status             FinanceStatus @default(pending)
  bankReference      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead               Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

model ServiceBooking {
  id                  Int           @id @default(autoincrement())
  tenantId            Int
  customerId          Int?
  vehicleRegistration String
  vehicleMake         String
  vehicleModel        String
  serviceType         String
  description         String?
  bookingDate         DateTime
  bookingTime         String
  advisorId           Int?
  status              ServiceStatus @default(booked)
  reminder48hSent     Boolean       @default(false)
  reminder2hSent      Boolean       @default(false)
  jobCardNumber       String?
  invoiceAmount       Decimal?      @db.Decimal(12, 2)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, bookingDate, status])
}

model PartsEnquiry {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  customerName  String
  customerPhone String?
  vehicleMake   String
  vehicleModel  String
  partName      String
  partNumber    String?
  quantity      Int         @default(1)
  status        PartsStatus @default(enquiry)
  priceQuoted   Decimal?    @db.Decimal(12, 2)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model PartCatalogItem {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  partNumber  String
  description String
  fitment     String?
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, partNumber])
}

model Customer {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  firstName        String
  lastName         String
  email            String?
  phone            String?
  whatsappNumber   String?
  idNumber         String?
  address          String?
  vehicleOwnedMake String?
  vehicleOwnedModel String?
  vehicleOwnedYear Int?
  registration     String?
  vin              String?
  purchaseDate     DateTime?
  loyaltyPoints    Int       @default(0)
  npsScore         Int?
  lastContactAt    DateTime?
  tags             Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceBookings  ServiceBooking[]

  @@index([tenantId, lastName, phone])
}

model AutomationSequence {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String
  triggerType String
  description String?
  steps       Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs        AutomationExecution[]

  @@index([tenantId, triggerType])
}

model AutomationExecution {
  id          Int                 @id @default(autoincrement())
  tenantId    Int
  sequenceId  Int?
  jobName     String
  status      String
  payload     Json?
  result      Json?
  error       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequence    AutomationSequence? @relation(fields: [sequenceId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

model TenantNotificationSetting {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  channel     String
  destination String?
  templateKey String?
  status      String
  payload     Json?
  response    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WidgetSetting {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @unique
  bubbleColor    String   @default("#1B2A4A")
  accentColor    String   @default("#C9A84C")
  greeting       String
  dealershipName String
  logoUrl        String?
  position       String   @default("bottom-right")
  showLeadForm   Boolean  @default(true)
  whatsappNumber String?
  widgetTitle    String   @default("AI Assistant")
  offlineMessage String?
  businessHours  String?
  autoOpenDelay  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model IntegrationConnection {
  id               Int               @id @default(autoincrement())
  tenantId         Int
  type             IntegrationType
  status           IntegrationStatus @default(unconfigured)
  displayName      String?
  encryptedSecret  String?
  encryptedConfig  String?
  metadata         Json?
  lastTestedAt     DateTime?
  lastError        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

model WhatsappSetting {
  id                 Int      @id @default(autoincrement())
  tenantId           Int      @unique
  whatsappNumber     String?
  encryptedApiKey    String?
  encryptedWebhookSecret String?
  webhookRegistered  Boolean  @default(false)
  registeredWebhookUrl String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ApiSetting {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  serviceName    String
  encryptedKey   String
  status         String   @default("unverified")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceName])
}

model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  eventType  String
  entityId   Int?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SupportManual {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  title       String
  make        String?
  model       String?
  url         String?
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SupportFaq {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  question    String
  answer      String
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SupportQuery {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  customerName String?
  channel     String?
  query       String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WebhookIdempotency {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  provider    String
  key         String
  payloadHash String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, key])
}
